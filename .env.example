# ========== 主模型（必填） ==========
# 兼容 OpenAI Chat Completions 协议的模型
BRAIN_API_KEY=your-api-key-here
BRAIN_API_URL=https://api.openai.com/v1
BRAIN_MODEL_NAME=gpt-4o-mini

# ========== curator 反思模型（可选，缺省复用主模型） ==========
# OPTIMIZER_API_KEY=
# OPTIMIZER_API_URL=
# OPTIMIZER_MODEL_NAME=

# ========== 联网搜索（可选，安装 pip install tavily-python 后生效） ==========
# TAVILY_API_KEY=

# ========== 服务配置（可选） ==========
# HOST=127.0.0.1
# PORT=8321
